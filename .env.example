# Copy this file to .env.local and fill in the values
# Base URL of the Breezy API gateway (matches API_GATEWAY_PORT in Breezy-api-1/.env)
NEXT_PUBLIC_API_URL=http://localhost:3010
# Set to "true" to serve mocked data via MSW instead of hitting the real API
NEXT_PUBLIC_USE_MSW=false
# Optional: Google OAuth client ID (matches GOOGLE_CLIENT_ID in the API).
# Leave empty to hide the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
